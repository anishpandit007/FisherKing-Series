s\n\n"],"color":"#323","bgcolor":"#535"},{"id":20,"type":"CR Simple Image Compare","pos":[-1017.3365614408744,-27.564652235492105],"size":[400.0000000000002,282],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"image1","name":"image1","shape":7,"type":"IMAGE","link":20},{"localized_name":"image2","name":"image2","shape":7,"type":"IMAGE","link":19},{"localized_name":"text1","name":"text1","type":"STRING","widget":{"name":"text1"},"link":null},{"localized_name":"text2","name":"text2","type":"STRING","widget":{"name":"text2"},"link":null},{"localized_name":"footer_height","name":"footer_height","type":"INT","widget":{"name":"footer_height"},"link":null},{"localized_name":"font_name","name":"font_name","type":"COMBO","widget":{"name":"font_name"},"link":null},{"localized_name":"font_size","name":"font_size","type":"INT","widget":{"name":"font_size"},"link":null},{"localized_name":"mode","name":"mode","type":"COMBO","widget":{"name":"mode"},"link":null},{"localized_name":"border_thickness","name":"border_thickness","type":"INT","widget":{"name":"border_thickness"},"link":null}],"outputs":[{"localized_name":"image","name":"image","type":"IMAGE","links":[18]},{"localized_name":"show_help","name":"show_help","type":"STRING","links":null}],"properties":{"cnr_id":"ComfyUI_Comfyroll_CustomNodes","ver":"d78b780ae43fcf8c6b7c6505e6ffb4584281ceca","Node name for S&R":"CR Simple Image Compare","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["Original Image","Restored Image",100,"Roboto-Regular.ttf",50,"dark",20]},{"id":5,"type":"FaceRestoreCFWithModel","pos":[-1013.0782278532243,-347.3979855688262],"size":[396.9499994913738,108.66666666666669],"flags":{},"order":4,"mode":0,"inputs":[{"localized_name":"facerestore_model","name":"facerestore_model","type":"FACERESTORE_MODEL","link":1},{"localized_name":"image","name":"image","type":"IMAGE","link":2},{"localized_name":"facedetection","name":"facedetection","type":"C