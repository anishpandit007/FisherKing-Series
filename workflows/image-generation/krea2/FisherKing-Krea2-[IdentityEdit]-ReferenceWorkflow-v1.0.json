trength_model","name":"strength_model","type":"FLOAT","widget":{"name":"strength_model"},"link":null},{"localized_name":"strength_clip","name":"strength_clip","type":"FLOAT","widget":{"name":"strength_clip"},"link":null}],"outputs":[{"localized_name":"MODEL","name":"MODEL","type":"MODEL","links":[20]},{"localized_name":"CLIP","name":"CLIP","type":"CLIP","links":[21]}],"properties":{"cnr_id":"comfy-core","ver":"0.27.0","Node name for S&R":"LoraLoader","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["KREA2\\krea2_identity_edit_v1_2.safetensors",1,1],"color":"#2a363b","bgcolor":"#3f5159","ndSuperSelectorEnabled":false,"ndPowerEnabled":false},{"id":20,"type":"Note","pos":[-2469.92172375989,57.28719961868457],"size":[609.0555555555557,928.6666666666665],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[],"title":"Workflow Notes","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["Workflow Goal\n\nProvide a clean reference implementation for identity-preserving image editing using Krea2 Identity Edit.\n\nThis workflow demonstrates instruction-based image editing while preserving the original subject's identity, composition, and overall visual consistency.\n\nTreat this workflow as a starting point and adapt the edit instructions to suit your own creative workflow.\n\nWorkflow Philosophy\n\nFisherKing Reference Workflows are intentionally minimal. They focus on demonstrating a validated baseline rather than exposing every possible option. Once the baseline is understood, users are encouraged to extend the workflow to suit their own production pipelines.\n\nWorkflow Type\n\nImage-to-Image (Identity-Preserving Editing)\n\nThis workflow uses the Krea2 Identity Edit LoRA together with the ComfyUI-Krea2Edit custom nodes.\n\nUnlike traditional Image-to-Image workflows that rely primarily on denoising strength, this implementation uses Krea2's reference-guided editing pipeline to preserve the original subject while applying natural-language edit instructions.\n\nAbout this Workflow\n\nThe goal of this reference workflow is to provide a simple, educational implementation of the core editing pipeline.\n\nTypical editing tasks include:\n\n✓ Clothing color changes\n\n✓ Background replacement\n\n✓ Object addition and removal\n\n✓ Character re-staging\n\n✓ Style transfer\n\n✓ Identity-preserving modifications\n\nObserved Behavior\n\nDuring validation, the workflow produced:\n\n✓ Excellent identity preservation\n\n✓ Strong facial consistency\n\n✓ Natural lighting preservation\n\n✓ Very good prompt adherence\n\n✓ High-quality localized edits\n\nAs with most AI image editing workflows, results may vary depending on:\n\nEdit instruction\nRandom seed\nReference image quality\nref_boost setting\n\nIf the desired edit is not achieved on the first attempt, consider:\n\nRefining the edit instruction\nTrying a different random seed\nAdjusting the ref_boost value\nRegenerating the image\nVersion\n\nVersion 1.0\n\nCreated as a minimal reference workflow for getting started with Krea2 Identity Edit.\n\nPurpose\n\n✓ Educational\n\n✓ Minimal\n\n✓ Easy to extend\n\n✓ Low VRAM Friendly\n\nVerified\n\n✓ Identity-Preserving Image Editing\n\n✓ Image-to-Image Editing\n\nVerified Settings\n\n✓ Steps: 10\n\n✓ CFG: 1.0\n\n✓ Sampler: Euler\n\n✓ Scheduler: Simple\n\n✓ LoRA Strength: 1.0\n\nThese settings were used during validation and are recommended as the baseline configuration.\n\nVerified Resolution\n\n✓ 832 × 1216\n\nAdditional resolutions may also work depending on the reference image and editing task.\n\nHardware Tested\n\n✓ NVIDIA RTX 2080 (8 GB VRAM)\n\n✓ 64 GB System RAM\n\n✓ ComfyUI 0.27.x\n\nResources\nBase Model\n\n• Krea2 Turbo\n\nLoRA\n\n• Krea2 Identity Edit v1.2\n\nCustom Nodes\n\n• ComfyUI-Krea2Edit\n\nAdditional Documentation\n\nThis workflow intentionally keeps the embedded documentation concise.\n\nFor installation instructions, recommended settings, supported features, known limitations, and future updates, please refer to the original author's project page.\n\nCredits\n\nSpecial thanks to the original author of Krea2 Identity Edit for creating and maintaining both the LoRA and the accompanying custom nodes.\n\nPlease refer to the original project page for complete documentation, release notes, and future updates."],"color":"#323","bgcolor":"#535"},{"id":21,"type":"Note","pos":[-1857.866168204341,55.287199618684454],"size":[327.38888888888914,934.8333333333333],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[],"title":"Resources","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["Important\n\nThis workflow relies on the ComfyUI-Krea2Edit custom node for reference-guided image conditioning. A standard Image-to-Image pipeline without this node will not produce the intended identity-preserving editing behavior.\n\nModels Used in this Workflow\nBase Model\n\n• Krea2TurboNSFWAIO_v10\n\nLoRA\n\n• krea2_identity_edit_v1_2\n\nRequired Custom Node\n\nThis workflow requires the ComfyUI-Krea2Edit custom node.\n\nDownloads\nBase Model (Krea2 Turbo NSFW AIO)\n\nhttps://civitai.red/models/2732185/krea2-turbo-nsfw-aio\n\nLoRA (Krea2 Identity Edit)\n\nhttps://civitai.red/models/2761113/krea-2-identity-edit\n\nComfyUI-Krea2Edit\n\nhttps://github.com/lbouaraba/comfyui-krea2edit\n\nInstall using:\n\ngit clone https://github.com/lbouaraba/comfyui-krea2edit.git\n\ninside your ComfyUI/custom_nodes directory.\n\nOriginal Project\n\nThis workflow is a minimal reference implementation built around the excellent work of the original author.\n\nFor installation instructions, recommended settings, known limitations, release notes, and future updates, please refer to the original project pages listed above.\n\nCredits\n\nSpecial thanks to the original developers of Krea2 Turbo, Krea2 Identity Edit, and ComfyUI-Krea2Edit for creating and maintaining these excellent models and tools."],"color":"#323","bgcolor":"#535"},{"id":11,"type":"KSampler","pos":[-824.0078363968823,459.28719961868455],"size":[270,262],"flags":{},"order":9,"mode":0,"inputs":[{"localized_name":"model","name":"model","type":"MODEL","link":9},{"localized_name":"positive","name":"positive","type":"CONDITIONING","link":10},{"localized_name":"negative","name":"negative","type":"CONDITIONING","link":11},{"localized_name":"latent_image","name":"latent_image","type":"LATENT","link":14},{"localized_name":"seed","name":"seed","type":"INT","widget":{"name":"seed"},"link":null},{"localized_name":"steps","name":"steps","type":"INT","widget":{"name":"steps"},"link":null},{"localized_name":"cfg","name":"cfg","type":"FLOAT","widget":{"name":"cfg"},"link":null},{"localized_name":"sampler_name","name":"sampler_name","type":"COMBO","widget":{"name":"sampler_name"},"link":null},{"localized_name":"scheduler","name":"scheduler","type":"COMBO","widget":{"name":"scheduler"},"link":null},{"localized_name":"denoise","name":"denoise","type":"FLOAT","widget":{"name":"denoise"},"link":null}],"outputs":[{"localized_name":"LATENT","name":"LATENT","type":"LATENT","links":[15]}],"properties":{"cnr_id":"comfy-core","ver":"0.27.0","Node name for S&R":"KSampler","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":[787614283926443,"randomize",12,1,"euler","simple",1],"color":"#322","bgcolor":"#533"},{"id":8,"type":"CLIPTextEncode","pos":[-1004.0078363968823,66.28719961868455],"size":[455,202],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":21},{"localized_name":"text","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"localized_name":"CONDITIONING","name":"CONDITIONING","type":"CONDITIONING","links":[7,10]}],"title":"Positive","properties":{"cnr_id":"comfy-core","ver":"0.27.0","Node name for S&R":"CLIPTextEncode","ue_properti